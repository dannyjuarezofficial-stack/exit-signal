{
  "name": "divine-lake-04ab",
  "main": "./src/exit-signal-events-worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "getexitsignal.com/*",
      "zone_name": "getexitsignal.com"
    },
    {
      "pattern": "www.getexitsignal.com/*",
      "zone_name": "getexitsignal.com"
    }
  ],
  "workers_dev": true,
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "exit_signal_events"
    }
  ],
  "previews": {
    "analytics_engine_datasets": [
      {
        "binding": "EVENTS",
        "dataset": "exit_signal_events"
      }
    ]
  }
}
