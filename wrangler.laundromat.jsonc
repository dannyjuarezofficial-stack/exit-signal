{
  "name": "laundromat-exit-v1-candidate",
  "main": "./src/laundromat-worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "exit_signal_events"
    }
  ]
}